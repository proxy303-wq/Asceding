# DhanHQ credentials (https://dhanhq.co -> API Settings)
# NOTE: Order placement/modification/cancellation requires your public IP
# to be whitelisted in DhanHQ settings. Data APIs work without whitelisting.
DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# Trading mode: paper (default, safe) or live (REAL MONEY)
TRADING_MODE=paper

# Telegram alerts (optional). The bot also auto-loads credentials from
# C:\Athena_X\.env when that file exists.
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id

